rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default catch-all: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == "valentinoarya900@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate a MenuItem schema
    function isValidMenuItem(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.description is string && data.description.size() <= 2000 &&
             data.image is string && data.image.size() <= 2000 &&
             (!data.keys().hasAll(['pieces']) || (data.pieces is number && data.pieces >= 0)) &&
             (!data.keys().hasAll(['isBestSeller']) || data.isBestSeller is bool);
    }

    // Helper to validate AppSettings schema
    function isValidAppSettings(data) {
      return (!data.keys().hasAll(['logoUrl']) || (data.logoUrl is string && data.logoUrl.size() <= 2000)) &&
             (!data.keys().hasAll(['name']) || (data.name is string && data.name.size() <= 100));
    }

    // 1. Menu Items collection
    match /menu_items/{menuItemId} {
      allow read: if true; // Public can see the menu
      allow write: if isValidId(menuItemId);
    }

    // 2. Settings collection
    match /settings/{settingsId} {
      allow read: if true; // Public can see settings
      allow write: if isValidId(settingsId);
    }

    // 3. Testimonials/Reviews collection
    match /testimonials/{testimonialId} {
      allow read: if true; // Public can see testimonials
      allow write: if isValidId(testimonialId);
    }

    // 4. Instagram posts collection
    match /instagram_posts/{postId} {
      allow read: if true; 
      allow write: if isValidId(postId);
    }

    // 5. TikTok posts collection
    match /tiktok_posts/{postId} {
      allow read: if true; 
      allow write: if isValidId(postId);
    }

    // 6. FAQs collection
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isValidId(faqId);
    }

    // 7. Info Tambahan collection
    match /info_tambahan/{infoId} {
      allow read: if true;
      allow write: if isValidId(infoId);
    }

    // 8. About Slides collection
    match /about_slides/{slideId} {
      allow read: if true;
      allow write: if isValidId(slideId);
    }

    // 9. Invoices collection (Checkout Receipt and Tracking)
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if isValidId(invoiceId);
    }

    // 10. WhatsApp Clicks
    match /wa_clicks/{clickId} {
      allow read: if true;
      allow write: if isValidId(clickId);
    }

    // 11. Traffic/Event Analytics tracking
    match /analytics_events/{eventId} {
      allow read: if true;
      allow write: if isValidId(eventId);
    }

    // 12. Test connection document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
